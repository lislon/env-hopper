{
  "name": "@env-hopper/source-gitlab",
  "version": "2.2.0",
  "description": "Read deployments, environments and releases from a GitLab instance",
  "keywords": [
    "env-hopper",
    "gitlab",
    "deployments",
    "environments",
    "releases"
  ],
  "homepage": "https://github.com/lislon/env-hopper",
  "bugs": {
    "url": "https://github.com/lislon/env-hopper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lislon/env-hopper.git",
    "directory": "packages/source-gitlab"
  },
  "license": "MIT",
  "author": "Igor Golovin",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "my-custom-condition": "./src/index.ts",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "premove ./dist ./coverage ./dist-ts",
    "compile": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "test:build": "publint --strict && attw --pack --ignore-rules cjs-resolves-to-esm",
    "test:eslint": "eslint ./src",
    "test:unit": "vitest --run",
    "test:unit:dev": "vitest --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@tanstack/vite-config": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=16"
  }
}
