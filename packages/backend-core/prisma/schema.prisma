// Prisma schema for backend-core library
// Uses EH_CORE_DATABASE_URL environment variable

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ========== Better Auth Models ==========
model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // 'user' | 'admin'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      account[]
  sessions      session[]
}

model session {
  id        String   @id
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model account {
  id                    String    @id
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ========== EnvHopper Models ==========
// No additional models needed for core resource jumping functionality

// ========== Catalog (see CONTEXT.md) ==========
// Each row belongs to the scope that last synced it; a sync deletes the rows
// of its scope it no longer reports.
model CatalogEnvironment {
  slug        String  @id
  scope       String
  displayName String
  description String?
  meta        Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  targets     CatalogDeploymentTarget[]

  @@index([scope])
}

model CatalogApp {
  slug        String             @id
  scope       String
  displayName String
  /// The Component that stands for the App where one Version is shown.
  leadComponentSlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  components  CatalogComponent[]

  @@index([scope])
}

model CatalogComponent {
  slug        String  @id
  scope       String
  displayName String
  appSlug     String?
  app         CatalogApp? @relation(fields: [appSlug], references: [slug])
  externalIds Json    @default("{}")
  /// The page of a commit of its code, with `{{sha}}` where the commit goes.
  commitUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artifacts   CatalogArtifact[]
  deployments CatalogDeployment[]
  attempts    CatalogDeployAttempt[]

  @@index([scope])
}

model CatalogDeploymentTarget {
  slug            String  @id
  scope           String
  displayName     String
  environmentSlug String?
  environment     CatalogEnvironment? @relation(fields: [environmentSlug], references: [slug])
  meta            Json    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deployments     CatalogDeployment[]
  attempts        CatalogDeployAttempt[]

  @@index([scope])
}

model CatalogRelease {
  key        String    @id
  scope      String
  tag        String?
  commitSha  String?
  author     String?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  artifacts  CatalogArtifact[]

  @@index([scope])
}

model CatalogArtifact {
  componentSlug String
  version       String
  scope         String
  aliases       String[]  @default([])
  releaseKey    String?
  builtAt       DateTime?
  /// Where builtAt came from: `build` (the build itself) or `deploy` (its first deploy, when the build time is unknown).
  builtAtSource String?
  buildUrl      String?
  /// The commit the build was made from.
  commitSha     String?
  /// The change request the build was made from (`direct`) or merged by: a ChangeRequestRef.
  changeRequest Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  component     CatalogComponent @relation(fields: [componentSlug], references: [slug], onDelete: Cascade)
  release       CatalogRelease?  @relation(fields: [releaseKey], references: [key], onDelete: SetNull)
  deployments   CatalogDeployment[]
  attempts      CatalogDeployAttempt[]

  @@id([componentSlug, version])
  @@index([componentSlug, builtAt])
  @@index([scope])
}

model CatalogDeployment {
  componentSlug String
  targetSlug    String
  version       String
  scope         String
  source        String
  deployedAt    DateTime?
  deployedBy    String?
  deployUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deployer      CatalogUser?            @relation(fields: [deployedBy], references: [username], onDelete: SetNull)
  component     CatalogComponent        @relation(fields: [componentSlug], references: [slug], onDelete: Cascade)
  target        CatalogDeploymentTarget @relation(fields: [targetSlug], references: [slug], onDelete: Cascade)
  artifact      CatalogArtifact         @relation(fields: [componentSlug, version], references: [componentSlug, version], onDelete: Cascade)
  endpoints     CatalogEndpoint[]

  @@id([componentSlug, targetSlug])
  @@index([scope])
}

// A deploy run of an Artifact to a Target that has not succeeded (yet): one
// per (Component, Target), the one the Entity Provider chose to show.
model CatalogDeployAttempt {
  componentSlug String
  targetSlug    String
  version       String
  scope         String
  /// running, failed or canceled.
  status        String
  startedAt     DateTime?
  endedAt       DateTime?
  startedBy     String?
  deployUrl     String?
  jobUrl        String?
  /// The branch, tag or merge-request ref deployed.
  ref           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  starter       CatalogUser?            @relation(fields: [startedBy], references: [username], onDelete: SetNull)
  component     CatalogComponent        @relation(fields: [componentSlug], references: [slug], onDelete: Cascade)
  target        CatalogDeploymentTarget @relation(fields: [targetSlug], references: [slug], onDelete: Cascade)
  artifact      CatalogArtifact         @relation(fields: [componentSlug, version], references: [componentSlug, version], onDelete: Cascade)

  @@id([componentSlug, targetSlug])
  @@index([scope])
}

// A person a Source names, e.g. a deployer. Not a login account.
model CatalogUser {
  username    String   @id
  scope       String
  email       String?
  provider    String?
  firstName   String?
  lastName    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deployments CatalogDeployment[]
  attempts    CatalogDeployAttempt[]

  @@index([scope])
}

model CatalogEndpoint {
  id            Int     @id @default(autoincrement())
  componentSlug String
  targetSlug    String
  kind          String
  label         String?
  url           String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deployment    CatalogDeployment @relation(fields: [componentSlug, targetSlug], references: [componentSlug, targetSlug], onDelete: Cascade)

  @@unique([componentSlug, targetSlug, kind, url])
}

// Health is written independently of Deployments (any Source, any time), so it
// is keyed like a Deployment but not owned by one.
model CatalogHealth {
  componentSlug String
  targetSlug    String
  scope         String
  state         String
  observedAt    DateTime
  checker       String
  detail        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([componentSlug, targetSlug])
  @@index([scope])
}

// How fresh what an App shows on an Environment is: when the Entity Provider
// last confirmed it, what it is reading for it now, and a read that failed.
model AppEnvFreshness {
  appSlug      String
  envSlug      String
  scope        String
  checkedAt    DateTime
  reading      String[]  @default([])
  failedSource String?
  failedAt     DateTime?
  // Each Source read for it, and when: [{ source, at }].
  sources      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@id([appSlug, envSlug])
  @@index([scope])
}

// Anyone using env-hopper, signed in or not: a random id kept in a cookie,
// and the login id once known.
model EhUser {
  id          String      @id
  loginId     String?
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  events      UserEvent[]

  @@index([loginId])
}

// One thing a user did: opened an App on an Environment, or jumped from it.
model UserEvent {
  id           Int      @id @default(autoincrement())
  userId       String
  /// open | jump
  kind         String
  appSlug      String
  envSlug      String
  resourceJump String?
  url          String?
  at           DateTime @default(now())
  user         EhUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
}
