// Prisma schema for backend-core library
// Uses EH_CORE_DATABASE_URL environment variable

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ========== Better Auth Models ==========
model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // 'user' | 'admin'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      account[]
  sessions      session[]
}

model session {
  id        String   @id
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model account {
  id                    String    @id
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ========== EnvHopper Models ==========
// No additional models needed for core resource jumping functionality

// ========== Catalog (see CONTEXT.md) ==========
model CatalogEnvironment {
  slug        String  @id
  displayName String
  description String?
  meta        Json    @default("{}")
  targets     CatalogDeploymentTarget[]
}

model CatalogApp {
  slug        String             @id
  displayName String
  components  CatalogComponent[]
}

model CatalogComponent {
  slug        String  @id
  displayName String
  appSlug     String?
  app         CatalogApp? @relation(fields: [appSlug], references: [slug])
  externalIds Json    @default("{}")
  artifacts   CatalogArtifact[]
  deployments CatalogDeployment[]
}

model CatalogDeploymentTarget {
  slug            String  @id
  displayName     String
  environmentSlug String?
  environment     CatalogEnvironment? @relation(fields: [environmentSlug], references: [slug])
  meta            Json    @default("{}")
  deployments     CatalogDeployment[]
}

model CatalogRelease {
  key       String    @id
  scope     String
  tag       String?
  commitSha String?
  author    String?
  createdAt DateTime?
  artifacts CatalogArtifact[]

  @@index([scope])
}

model CatalogArtifact {
  componentSlug String
  version       String
  aliases       String[]  @default([])
  releaseKey    String?
  builtAt       DateTime?
  component     CatalogComponent @relation(fields: [componentSlug], references: [slug])
  release       CatalogRelease?  @relation(fields: [releaseKey], references: [key], onDelete: SetNull)
  deployments   CatalogDeployment[]

  @@id([componentSlug, version])
  @@index([componentSlug, builtAt])
}

model CatalogDeployment {
  componentSlug String
  targetSlug    String
  version       String
  scope         String
  source        String
  deployedAt    DateTime?
  component     CatalogComponent        @relation(fields: [componentSlug], references: [slug])
  target        CatalogDeploymentTarget @relation(fields: [targetSlug], references: [slug])
  artifact      CatalogArtifact         @relation(fields: [componentSlug, version], references: [componentSlug, version])
  endpoints     CatalogEndpoint[]

  @@id([componentSlug, targetSlug])
  @@index([scope])
}

model CatalogEndpoint {
  id            Int     @id @default(autoincrement())
  componentSlug String
  targetSlug    String
  kind          String
  label         String?
  url           String
  deployment    CatalogDeployment @relation(fields: [componentSlug, targetSlug], references: [componentSlug, targetSlug], onDelete: Cascade)

  @@index([componentSlug, targetSlug])
}

// Health is written independently of Deployments (any Source, any time), so it
// is keyed like a Deployment but not owned by one.
model CatalogHealth {
  componentSlug String
  targetSlug    String
  scope         String
  state         String
  observedAt    DateTime
  checker       String
  detail        String?

  @@id([componentSlug, targetSlug])
  @@index([scope])
}
