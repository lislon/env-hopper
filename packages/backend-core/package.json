{
  "name": "@env-hopper/backend-core",
  "version": "2.6.1",
  "description": "Backend core library for Env Hopper",
  "homepage": "https://github.com/lislon/env-hopper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lislon/env-hopper.git",
    "directory": "packages/backend-core"
  },
  "license": "MIT",
  "author": "Igor Golovin",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "my-custom-condition": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "my-custom-condition": "./src/testing/index.ts",
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "./testing/global-setup": {
      "my-custom-condition": "./src/testing/globalSetup.ts",
      "import": {
        "types": "./dist/testing/globalSetup.d.ts",
        "default": "./dist/testing/globalSetup.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "prisma",
    "prisma.config.ts",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsdown",
    "build:lenient": "tsdown",
    "clean": "premove ./dist ./coverage ./dist-ts",
    "compile": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "test:eslint": "eslint ./src",
    "test:unit": "vitest",
    "test:unit:dev": "pnpm run test:unit --watch"
  },
  "dependencies": {
    "@env-hopper/shared-core": "workspace:*",
    "@env-hopper/table-sync": "workspace:*",
    "@kubernetes/client-node": "^1.2.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/express": "catalog:",
    "ai": "^6.0.37",
    "better-auth": "^1.4.18",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv-defaults": "catalog:",
    "express": "catalog:",
    "jsonwebtoken": "^9.0.2",
    "multer": "catalog:",
    "node-cron": "^4.2.1",
    "radashi": "catalog:",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.33.5",
    "tsyringe": "^4.10.0",
    "yaml": "^2.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tanstack/vite-config": "catalog:",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.18",
    "@types/dotenv-defaults": "catalog:",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "prisma": "catalog:",
    "prisma-json-types-generator": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  }
}
