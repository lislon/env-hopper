// Prisma schema for backend-core library
// Uses EH_CORE_DATABASE_URL environment variable

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ========== Better Auth Models ==========
model user {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // 'user' | 'admin'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      account[]
  sessions      session[]
}

model session {
  id        String   @id
  token     String   @unique
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model account {
  id                    String    @id
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  idToken               String?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ========== EnvHopper Models ==========
// No additional models needed for core resource jumping functionality

// ========== Catalog (see CONTEXT.md) ==========
// Each row belongs to the scope that last synced it; a sync deletes the rows
// of its scope it no longer reports.
model CatalogEnvironment {
  slug        String  @id
  scope       String
  displayName String
  description String?
  meta        Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  targets     CatalogDeploymentTarget[]

  @@index([scope])
}

model CatalogApp {
  slug        String             @id
  scope       String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  components  CatalogComponent[]

  @@index([scope])
}

model CatalogComponent {
  slug        String  @id
  scope       String
  displayName String
  appSlug     String?
  app         CatalogApp? @relation(fields: [appSlug], references: [slug])
  externalIds Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  artifacts   CatalogArtifact[]
  deployments CatalogDeployment[]

  @@index([scope])
}

model CatalogDeploymentTarget {
  slug            String  @id
  scope           String
  displayName     String
  environmentSlug String?
  environment     CatalogEnvironment? @relation(fields: [environmentSlug], references: [slug])
  meta            Json    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deployments     CatalogDeployment[]

  @@index([scope])
}

model CatalogRelease {
  key        String    @id
  scope      String
  tag        String?
  commitSha  String?
  author     String?
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  artifacts  CatalogArtifact[]

  @@index([scope])
}

model CatalogArtifact {
  componentSlug String
  version       String
  scope         String
  aliases       String[]  @default([])
  releaseKey    String?
  builtAt       DateTime?
  buildUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  component     CatalogComponent @relation(fields: [componentSlug], references: [slug], onDelete: Cascade)
  release       CatalogRelease?  @relation(fields: [releaseKey], references: [key], onDelete: SetNull)
  deployments   CatalogDeployment[]

  @@id([componentSlug, version])
  @@index([componentSlug, builtAt])
  @@index([scope])
}

model CatalogDeployment {
  componentSlug String
  targetSlug    String
  version       String
  scope         String
  source        String
  deployedAt    DateTime?
  deployedBy    String?
  deployUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deployer      CatalogUser?            @relation(fields: [deployedBy], references: [username], onDelete: SetNull)
  component     CatalogComponent        @relation(fields: [componentSlug], references: [slug], onDelete: Cascade)
  target        CatalogDeploymentTarget @relation(fields: [targetSlug], references: [slug], onDelete: Cascade)
  artifact      CatalogArtifact         @relation(fields: [componentSlug, version], references: [componentSlug, version], onDelete: Cascade)
  endpoints     CatalogEndpoint[]

  @@id([componentSlug, targetSlug])
  @@index([scope])
}

// A person a Source names, e.g. a deployer. Not a login account.
model CatalogUser {
  username    String   @id
  scope       String
  email       String?
  provider    String?
  firstName   String?
  lastName    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deployments CatalogDeployment[]

  @@index([scope])
}

model CatalogEndpoint {
  id            Int     @id @default(autoincrement())
  componentSlug String
  targetSlug    String
  kind          String
  label         String?
  url           String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deployment    CatalogDeployment @relation(fields: [componentSlug, targetSlug], references: [componentSlug, targetSlug], onDelete: Cascade)

  @@unique([componentSlug, targetSlug, kind, url])
}

// Health is written independently of Deployments (any Source, any time), so it
// is keyed like a Deployment but not owned by one.
model CatalogHealth {
  componentSlug String
  targetSlug    String
  scope         String
  state         String
  observedAt    DateTime
  checker       String
  detail        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([componentSlug, targetSlug])
  @@index([scope])
}
